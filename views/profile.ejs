<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
      integrity="sha512-UtLOu9C7NuThQhuXXrGwx9Jb/z9zPQJctuAgNUBK3Z6kkSYT9wJ+2+dh6klS+TDBCV9kNPBbAxbVD+vCcfGPaA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/styles/profile-style.css" />
    <title>Document</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <div class="custom-container mt-3">
      <div class="row">
        <div class="col-12 col-md-3 p-3 d-flex flex-column align-items-center">
          <div class="profile"></div>
          <div
            class="rounded-circle"
            style="width: 200px; height: 200px; overflow: hidden; z-index: 1"
          >
            <img
              src="<%= user_data.profileImageURL %>"
              data-bs-toggle="modal"
              data-bs-target="#firstmodal"
              class="img-hover open-modal-button img-fluid"
              style="
                object-fit: contain;
                width: 200px;
                height: 200px;
                cursor: pointer;
              "
              alt="Profile Image"
            />
          </div>
          <h3
            class="mt-3 text-center d-flex justify-content-between align-items-center"
          >
            <div class="text-center"><%= user_data.fullName %></div>
            <% if (user._id == user_data._id) { %>
            <div>
              <a
                class="open-modal-button small-link icon-link icon-link-hover"
                style="
                  --bs-icon-link-transform: translate3d(0, -0.125rem, 0);
                  cursor: pointer;
                "
                data-bs-toggle="modal"
                data-bs-target="#datamodal"
              >
                Edit
                <svg
                  class="bi"
                  aria-hidden="true"
                  width="15"
                  height="15"
                  fill="currentColor"
                  x="0px"
                  y="0px"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M 19.171875 2 C 18.448125 2 17.724375 2.275625 17.171875 2.828125 L 16 4 L 20 8 L 21.171875 6.828125 C 22.275875 5.724125 22.275875 3.933125 21.171875 2.828125 C 20.619375 2.275625 19.895625 2 19.171875 2 z M 14.5 5.5 L 3 17 L 3 21 L 7 21 L 18.5 9.5 L 14.5 5.5 z"
                  ></path>
                </svg>
              </a>
            </div>
            <% } %>
          </h3>

          <p><%= user_data.email%></p>

          <% if (user._id == user_data._id) { %> <%-
          include('./partials/edit-profile-data') %> <% } %> <%-
          include('./partials/edit-profile-image') %> <% if (user._id ==
          user_data._id) { %> <%- include('./partials/delete-user') %> <% } %>
        </div>
        <div class="col-12 col-md-9 p-3">
          <% if (user._id == user_data._id) { %>
          <h1 class="mb-3">My Blogs</h1>
          <% } else { %>
          <h1 class="mb-3">Blogs</h1>
          <% } %> <% blogs.forEach(blog => { %>
          <a
            href="<%=`/blog/${blog._id}`%>"
            style="text-decoration: none; color: inherit"
          >
            <div class="card mb-3">
              <div class="row g-0" style="height: 20vh">
                <div class="col-3" style="height: 20vh">
                  <img
                    src="<%= blog.thumbnailURL %>"
                    class="img-fluid rounded-start"
                    style="height: 100%; width: 100%; object-fit: cover"
                    alt="Blog Thumbnail"
                  />
                </div>
                <div class="col-9">
                  <div class="card-body">
                    <h5 class="card-title"><%= blog.title %></h5>
                    <p class="card-text" style="max-height: 4.5em">
                      <%= blog.body %>
                    </p>
                    <p class="card-text">
                      <small class="text-muted">
                        <%= blog.createdAt.toLocaleString('en-US', { year:
                        'numeric', month: 'short', day: 'numeric', hour:
                        '2-digit', minute: '2-digit' }) %>
                      </small>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </a>
          <% }) %>
        </div>
      </div>
    </div>
    <%- include('./partials/scripts') %>
  </body>
</html>
