<% if (locals.user && locals.user._id == blog.createdBy._id) { %>

<div class="nav-item dropdown mt-2">
  <a
    class="nav-link dropdown-toggle"
    href="#"
    role="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    more options
  </a>
  <ul class="dropdown-menu">
    <li>
      <a
        class="dropdown-item"
        data-bs-toggle="modal"
        data-bs-target="#deleteModal"
        >delete</a
      >
    </li>
    <li><a class="dropdown-item" href="/user/editBlog">edit</a></li>
  </ul>
</div>

<!-- Modal -->
<div
  class="modal fade"
  id="deleteModal"
  tabindex="-1"
  aria-labelledby="exampleModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">Do you want to delete this blog?</div>
      <div class="modal-footer">
        <form action="<%= `/blog/delete/${blog._id}` %>" method="post">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>

          <button type="submit" class="btn btn-danger">delete</button>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %>
