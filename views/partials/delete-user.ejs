<script>
  function confirmFormSubmission(event) {
    // Prevent the default submission
    event.preventDefault();

    // Get form values
    const confirm = document.getElementById("confirm").value;
    console.log(confirm === "confirm");
    if (confirm === "confirm") event.target.submit();
  }
</script>
<!-- Button trigger modal -->
<button
  type="button"
  class="btn btn-danger"
  data-bs-toggle="modal"
  data-bs-target="#exampleModal"
>
  Delete Account
</button>

<!-- Modal -->
<div
  class="modal fade"
  id="exampleModal"
  tabindex="-1"
  aria-labelledby="exampleModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <p>To delete the account please type in <b>confirm</b></p>
        <form
          action="<%= `/user/delete/${user._id}` %>"
          method="post"
          onsubmit="confirmFormSubmission(event)"
        >
          <label for="confirm" class="form-label">Full Name</label>
          <input
            type="text"
            name="confirm"
            class="form-control"
            id="confirm"
            placeholder="confirm"
            required
          />
          <div class="modal-footer">
            <button type="submit" class="btn btn-danger">delete</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
