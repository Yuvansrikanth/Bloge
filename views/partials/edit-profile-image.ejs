<!-- Modal -->
<div
  class="modal fade"
  id="firstmodal"
  tabindex="-1"
  aria-labelledby="exampleModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Profile picture</h1>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <div class="image-container d-flex justify-content-center">
          <img
            src="<%= user_data.profileImageURL %>"
            class="img-fluid"
            style="object-fit: contain; width: 400px; height: 400px"
            alt="Profile Image"
          />
        </div>
        <% if (user._id == user_data._id) { %>
        <!-- Input for Image Upload -->
        <p class="text-muted mt-3">Upload new profile picture</p>
        <input type="file" id="img" class="form-control" accept="image/*" />
        <% } %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<% if (user._id == user_data._id) { %>
<!-- Modal for Image Cropper -->
<div
  class="modal modal-lg fade"
  id="staticBackdrop"
  tabindex="-1"
  aria-labelledby="staticBackdropLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="staticBackdropLabel">Crop your image</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-12 col-md-9">
            <div style="width: 95%">
              <img
                id="preview-image"
                src="/images/default.png"
                alt="Image Preview"
                style="width: 90%; display: block"
              />
            </div>
          </div>
          <div class="col-12 col-md-3">
            <div
              id="preview"
              style="overflow: hidden; width: 150px; height: 150px"
            ></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Close
        </button>
        <button type="button" id="uploadBtn" class="btn btn-primary">
          Upload
        </button>
      </div>
    </div>
  </div>
</div>

<script
  src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"
  integrity="sha512-JyCZjCOZoyeQZSd5+YEAcFgz2fowJ1F1hyJOXgtKu4llIa0KneLcidn5bwfutiehUTiOuK87A986BZJMko0eWQ=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
></script>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
  integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
></script>
<script src="/services/imageValidation.js"></script>
<% } %>
