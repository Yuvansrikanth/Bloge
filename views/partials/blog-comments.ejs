<div class="custom-container my-4">
  <h3>Comments (<%= comments.length %>)</h3>
  <% if (locals.user) { %>
  <form action="<%= `/blog/${blog._id}` %>" method="post">
    <div class="row mt-3">
      <div class="col-12 col-md-9 p-3">
        <div class="input-group">
          <textarea
            class="form-control"
            name="content"
            id="content"
            rows="3"
            style="padding: 0; margin: 0; font-size: 16px; line-height: 1.2"
            placeholder="Write your comment here..."
            required
          ></textarea>
        </div>
      </div>
      <div class="col-12 col-md-3 p-3">
        <button class="btn btn-primary" type="submit">Post</button>
      </div>
    </div>
  </form>
  <% } %>
</div>
<div class="custom-container">
  <div class="row">
    <% comments.forEach(comment => { %>
    <div class="col-12 mb-3">
      <div class="card shadow-sm">
        <div class="card-body d-flex align-items-start">
          <a
            href="<%= `/user/profile/${comment.createdBy._id}` %>"
            style="text-decoration: none; color: inherit"
          >
            <!-- Profile Image -->
            <img
              src="<%= comment.createdBy.profileImageURL || '/path/to/default/image.jpg' %>"
              alt="Profile"
              class="rounded-circle"
              style="width: 50px; height: 50px; object-fit: cover"
            />
          </a>
          <!-- Comment Content -->
          <div class="ms-3 w-100">
            <a
              href="<%= `/user/profile/${comment.createdBy._id}` %>"
              style="text-decoration: none; color: inherit"
            >
              <p class="fw-bold mb-1"><%= comment.createdBy.fullName %></p>
            </a>
            <p class="mb-0"><%= comment.content %></p>

            <!-- Date and Time -->
            <div class="d-flex justify-content-between align-items-center mt-2">
              <div>
                <small class="text-muted">
                  <%= comment.createdAt.toLocaleString('en-US', { year:
                  'numeric', month: 'long', day: 'numeric', hour: 'numeric',
                  minute: 'numeric' }) %>
                </small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>
